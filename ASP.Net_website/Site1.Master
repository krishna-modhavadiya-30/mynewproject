        <link rel="stylesheet" href="css/responsive.css" />
    </head>
    <body>
        <header class="sticky-top">
            <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center" href="Home.aspx">
                        <img src="https://images.unsplash.com/photo-1521587760476-6c12a4b040da?auto=format&fit=crop&w=80&q=80" alt="Library logo" class="me-2 rounded-circle" width="42" height="42" />
                        <span class="fw-bold text-primary">Campus Library</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="navbarNav">
                        <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                            <li class="nav-item"><a class="nav-link active" href="Home.aspx">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="BookSearch.aspx">Book Search</a></li>
                            <li class="nav-item"><a class="nav-link" href="Categories.aspx">Categories</a></li>
                            <li class="nav-item"><a class="nav-link" href="IssueBook.aspx">Issue Book</a></li>
                            <li class="nav-item"><a class="nav-link" href="ReturnBook.aspx">Return Book</a></li>
                            <%--<li class="nav-item"><a class="nav-link" href="Librarian_deshboard.aspx">Librarian Panel</a></li>--%>
                            <li class="nav-item"><a class="nav-link" href="About.aspx">About</a></li>
                            <li class="nav-item"><a class="nav-link" href="Contact.aspx">Contact</a></li>

                            <li class="nav-item dropdown ms-lg-3">
                                <a class="nav-link dropdown-toggle" href="#" id="loginDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">Login</a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="loginDropdown">
                                    <li><a class="dropdown-item" href="UserLogin.aspx">User Login</a></li>
                                   <%-- <li><a class="dropdown-item" href="Librarian_deshboard.aspx">Librarian Panel</a></li>--%>
                                    <a class="dropdown-item" href="LibrarianLogin.aspx">Librarian Panel</a>
                                    <li>
                                        <hr class="dropdown-divider">
                                    </li>
                                    <li>
                                        <button class="dropdown-item" type="button" id="adminLoginBtn" data-bs-toggle="modal" data-bs-target="#adminLoginModal">Admin Login</button></li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
</asp:ContentPlaceHolder>
<asp:ContentPlaceHolder ID="ContentPlaceHolder2" runat="server">
    <main>
        <section class="hero-section py-5">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-7">
                        <p class="text-primary fw-semibold mb-3">Modern Digital Library Experience</p>
                        <h1 class="display-5 fw-bold mb-4">Discover, Borrow, and Manage Books with Ease.</h1>
                        <p class="lead text-muted mb-4">
                            A smart library management experience designed for students, librarians, and administrators.
                        </p>
                        <div class="d-flex flex-wrap gap-3">
                            <a class="btn btn-primary rounded-pill px-4 py-2" href="Categories.aspx">Explore Books</a>
                            <a class="btn btn-outline-primary rounded-pill px-4 py-2" href="StudentRegistration.aspx">Join Library</a>
                        </div>
                        <div class="row mt-5 g-3">
                            <div class="col-md-4">
                                <div class="stat-card p-3 rounded-4 shadow-sm bg-white">
                                    <h3 class="fw-bold mb-1">12K+</h3>
                                    <p class="text-muted mb-0">Books Available</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-card p-3 rounded-4 shadow-sm bg-white">
                                    <h3 class="fw-bold mb-1">4.8/5</h3>
                                    <p class="text-muted mb-0">Student Rating</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="stat-card p-3 rounded-4 shadow-sm bg-white">
                                    <h3 class="fw-bold mb-1">24/7</h3>
                                    <p class="text-muted mb-0">Access Support</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <img src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?auto=format&fit=crop&w=900&q=80" alt="Library interior" class="img-fluid rounded-4 shadow" />
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5 bg-light">
            <div class="container">
                <div class="section-heading text-center mb-5">
                    <p class="text-primary fw-semibold mb-2">Featured Categories</p>
                    <h2 class="fw-bold">Explore Different Learning Areas</h2>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1516321497487-e288fb19713f?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Programming" height="180" />
                            <div class="card-body">
                                <h5 class="card-title">Programming</h5>
                                <p class="card-text text-muted">Modern coding guides and software development resources.</p>
                                <a href="Categories.aspx" class="btn btn-outline-primary btn-sm">View</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Science" height="180" />
                            <div class="card-body">
                                <h5 class="card-title">Science</h5>
                                <p class="card-text text-muted">Explore engineering, biology, and scientific discoveries.</p>
                                <a href="Categories.aspx" class="btn btn-outline-primary btn-sm">View</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Technology" height="180" />
                            <div class="card-body">
                                <h5 class="card-title">Technology</h5>
                                <p class="card-text text-muted">The latest books on AI, robotics, and digital innovation.</p>
                                <a href="Categories.aspx" class="btn btn-outline-primary btn-sm">View</a>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <img src="https://images.unsplash.com/photo-1516979187457-637abb4f9353?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="History" height="180" />
                            <div class="card-body">
                                <h5 class="card-title">History</h5>
                                <p class="card-text text-muted">Rich insights into cultures, history, and global events.</p>
                                <a href="Categories.aspx" class="btn btn-outline-primary btn-sm">View</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5">
            <div class="container">
                <div class="section-heading text-center mb-5">
                    <p class="text-primary fw-semibold mb-2">Featured Books</p>
                    <h2 class="fw-bold">Popular Titles in the Library</h2>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <img src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Book" height="220" />
                            <div class="card-body">
                                <h5 class="card-title">Clean Code</h5>
                                <p class="text-muted mb-2">Robert C. Martin</p>
                                <p class="small text-primary">Programming</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success-subtle text-success">Available</span>
                                    <span class="text-warning">★ 4.8</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <img src="https://images.unsplash.com/photo-1512820790803-83ca734da794?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Book" height="220" />
                            <div class="card-body">
                                <h5 class="card-title">Physics for Engineers</h5>
                                <p class="text-muted mb-2">M. Sharma</p>
                                <p class="small text-primary">Science</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-warning-subtle text-warning">Issued</span>
                                    <span class="text-warning">★ 4.5</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <img src="https://images.unsplash.com/photo-1495446815901-a7297e633e8d?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Book" height="220" />
                            <div class="card-body">
                                <h5 class="card-title">The Modern Web</h5>
                                <p class="text-muted mb-2">A. Ray</p>
                                <p class="small text-primary">Technology</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success-subtle text-success">Available</span>
                                    <span class="text-warning">★ 4.7</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-3">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <img src="https://images.unsplash.com/photo-1519682337058-a94d519337bc?auto=format&fit=crop&w=600&q=80" class="card-img-top rounded-top-4" alt="Book" height="220" />
                            <div class="card-body">
                                <h5 class="card-title">The History of Time</h5>
                                <p class="text-muted mb-2">S. Thomas</p>
                                <p class="small text-primary">History</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="badge bg-success-subtle text-success">Available</span>
                                    <span class="text-warning">★ 4.9</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5 bg-light">
            <div class="container">
                <div class="section-heading text-center mb-5">
                    <p class="text-primary fw-semibold mb-2">System Pages</p>
                    <h2 class="fw-bold">Everything You Need in One Library Portal</h2>
                </div>
                <div class="row g-4">
                    <div class="col-md-6 col-lg-4">
                        <div class="preview-card p-4 rounded-4 bg-white shadow-sm h-100">
                            <h5 class="fw-bold">Student Registration</h5>
                            <p class="text-muted">Create student accounts with profile upload and secure credentials.</p>
                            <a href="StudentRegistration.aspx" class="btn btn-sm btn-outline-primary">Open Page</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="preview-card p-4 rounded-4 bg-white shadow-sm h-100">
                            <h5 class="fw-bold">Admin Dashboard</h5>
                            <p class="text-muted">Monitor books, students, issued items, and recent activities.</p>
                            <a href="AdminDashboard.aspx" class="btn btn-sm btn-outline-primary">Open Page</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="preview-card p-4 rounded-4 bg-white shadow-sm h-100">
                            <h5 class="fw-bold">Book Search</h5>
                            <p class="text-muted">Search by title, category, or availability in seconds.</p>
                            <a href="BookSearch.aspx" class="btn btn-sm btn-outline-primary">Open Page</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="preview-card p-4 rounded-4 bg-white shadow-sm h-100">
                            <h5 class="fw-bold">Issue Book</h5>
                            <p class="text-muted">Issue books to students with clear issue and return dates.</p>
                            <a href="IssueBook.aspx" class="btn btn-sm btn-outline-primary">Open Page</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="preview-card p-4 rounded-4 bg-white shadow-sm h-100">
                            <h5 class="fw-bold">Return Book</h5>
                            <p class="text-muted">Track returned books and calculate fines instantly.</p>
                            <a href="ReturnBook.aspx" class="btn btn-sm btn-outline-primary">Open Page</a>
                        </div>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <div class="preview-card p-4 rounded-4 bg-white shadow-sm h-100">
                            <h5 class="fw-bold">Availability</h5>
                            <p class="text-muted">View available, issued, and reserved books at a glance.</p>
                            <a href="Availability.aspx" class="btn btn-sm btn-outline-primary">Open Page</a>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5">
            <div class="container">
                <div class="row align-items-center g-5">
                    <div class="col-lg-6">
                        <img src="https://images.unsplash.com/photo-1524995997946-a1c2e315a42f?auto=format&fit=crop&w=900&q=80" alt="Library services" class="img-fluid rounded-4 shadow" />
                    </div>
                    <div class="col-lg-6">
                        <p class="text-primary fw-semibold mb-2">Why Choose Us</p>
                        <h2 class="fw-bold mb-4">A library system built for modern study habits</h2>
                        <ul class="list-unstyled">
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i>Easy book search and filtering</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i>Simple issue and return workflows</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i>Professional dashboard for admin controls</li>
                            <li class="mb-3"><i class="bi bi-check-circle-fill text-primary me-2"></i>Responsive design for all devices</li>
                        </ul>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5 bg-light">
            <div class="container">
                <div class="section-heading text-center mb-5">
                    <p class="text-primary fw-semibold mb-2">Testimonials</p>
                    <h2 class="fw-bold">What Students Say</h2>
                </div>
                <div class="row g-4">
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <p class="text-muted">“The interface is simple, attractive, and fast. It makes finding books effortless.”</p>
                                <h6 class="fw-bold mb-0">Ananya Singh</h6>
                                <small class="text-primary">BCA Student</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <p class="text-muted">“The dashboard helps us track student activity and book movement very clearly.”</p>
                                <h6 class="fw-bold mb-0">Ravi Kumar</h6>
                                <small class="text-primary">Library Admin</small>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100">
                            <div class="card-body">
                                <p class="text-muted">“It feels like a real university library portal, polished and easy to use.”</p>
                                <h6 class="fw-bold mb-0">Meera Rao</h6>
                                <small class="text-primary">Final Year Student</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="py-5">
            <div class="container">
                <div class="row align-items-center g-4 p-4 rounded-4 bg-primary text-white shadow">
                    <div class="col-lg-8">
                        <h3 class="fw-bold mb-2">Stay updated with new arrivals</h3>
                        <p class="mb-0">Subscribe to receive updates on new books and library events.</p>
                    </div>
                    <div class="col-lg-4">
                        <form class="d-flex flex-wrap gap-2">
                            <input type="email" class="form-control" placeholder="Your email" />
                            <button class="btn btn-light text-primary">Subscribe</button>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </main>
</asp:ContentPlaceHolder>
<asp:ContentPlaceHolder ID="ContentPlaceHolder3" runat="server">
    <footer class="bg-dark text-white py-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3">Campus Library</h5>
                    <p class="text-light-emphasis">A clean and smart library system for students and administrators.</p>
                </div>
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="Categories.aspx" class="text-light-emphasis text-decoration-none">Categories</a></li>
                        <li class="mb-2"><a href="BookSearch.aspx" class="text-light-emphasis text-decoration-none">Search Books</a></li>
                        <li class="mb-2"><a href="Contact.aspx" class="text-light-emphasis text-decoration-none">Contact Us</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h5 class="fw-bold mb-3">Contact</h5>
                    <p class="text-light-emphasis mb-1">Email: info@campuslibrary.edu</p>
                    <p class="text-light-emphasis mb-1">Phone: +91 98765 43210</p>
                    <p class="text-light-emphasis">Address: 12, Knowledge Avenue</p>
                </div>
            </div>
        </div>s
    </footer>

    <button class="btn btn-primary rounded-circle back-to-top" id="backToTop" aria-label="Back to top">↑</button>

    <uc:AdminLogin ID="AdminLoginControl" runat="server" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="js/script.js"></script>
    </body>
</html>
</asp:ContentPlaceHolder>
